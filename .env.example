# Opcional: copiar a .env (no se sube a git). Sin .env, docker compose usa los valores por defecto.

# Capas del mapa de Inicio: alternates workspace:capa separados por coma (se incrustan al compilar)
VITE_HOME_LAYERS=

# Client ID de la Application OAuth2 'ide-front' (admin de GeoNode). Lo usa el servicio ide-auth.
VITE_OAUTH_CLIENT_ID=
# Clave del captcha (opcional): openssl rand -hex 32. Sin definir se genera una al arrancar.
#CAPTCHA_SECRET=

# Ruta donde cuelga el front, dominio público y servidor de la IDE
#IDE_BASE_PATH=/ide/
#PUBLIC_ORIGIN=https://ecodatos.ecologia.misiones.gob.ar
#GEONODE_ORIGIN=https://ide.ordenamientoterritorial.misiones.gob.ar
#IDE_ORIGIN=https://ide.ordenamientoterritorial.misiones.gob.ar
#IDE_HOST=ide.ordenamientoterritorial.misiones.gob.ar
#IDE_PORT=8091
